# Copy to .env:  cp .env.example .env     (deploy.sh does this automatically)
# .env is git-ignored. Never commit it.

# ---------------------------------------------------------------------------
# LLM model (pulled into Ollama by deploy.sh; LOCKED in the LDR UI by this value)
# ---------------------------------------------------------------------------
# Laptop / CPU test  (default):   gemma3:4b      (~3.3 GB)   or  qwen2.5:3b (~1.9 GB)
# Production, 24 GB VRAM GPU:     gemma3:12b     (~8 GB)     or  qwen3:14b  (~9 GB)
# To switch:  edit this line, then run  ./deploy.sh model
LDR_LLM_MODEL=gemma3:4b

# Concurrent requests per loaded model (1 = laptop, 4-5 = production GPU)
OLLAMA_NUM_PARALLEL=1

# ---------------------------------------------------------------------------
# Image / network
# ---------------------------------------------------------------------------
# Pin to a released version once validated (e.g. 2.0.4) for reproducible deploys.
LDR_IMAGE_TAG=latest
# 127.0.0.1 = local only. Use 0.0.0.0 only for LAN tests WITHOUT the proxy.
LDR_BIND_ADDR=127.0.0.1

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# true during first-run so you can create the admin account.
# ./deploy.sh harden  sets it to false and restarts LDR.
LDR_APP_ALLOW_REGISTRATIONS=true

# ---------------------------------------------------------------------------
# Reverse proxy profile (./deploy.sh up --proxy)
# ---------------------------------------------------------------------------
# 'localhost' => Caddy internal CA (browser warning, fine for demo).
# Real FQDN pointing at this host (ports 80/443 open) => Let's Encrypt, automatic.
LDR_DOMAIN=localhost
ACME_EMAIL=admin@example.com
# deploy.sh sets this to true when --proxy is used.
TRUST_PROXY_HEADERS=false
